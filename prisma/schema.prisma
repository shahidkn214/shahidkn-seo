generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  categoryTag String
  fixTag      String
  fixLine     String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Stat {
  id    String @id @default(cuid())
  value String
  label String
  order Int    @default(0)
}

model MarginNote {
  id    String @id @default(cuid())
  bold  String
  rest  String
  order Int    @default(0)
}

model Skill {
  id     String @id @default(cuid())
  skill  String
  tool   String
  column Int
  order  Int    @default(0)
}

model ProcessStep {
  id          String @id @default(cuid())
  label       String
  title       String
  description String
  order       Int    @default(0)
}

model SiteSettings {
  id              String @id @default("singleton")
  heroKicker      String
  heroHeadline    String
  heroSubtext     String
  contactEmail    String
  footerName      String @default("Shahid KN")
  footerRole      String @default("SEO Content Writer & Editor")
  footerTagline   String
  metaTitle       String
  metaDescription String
}
